{
  "name": "ui-skills",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "description": "Claude Code skills for visual UI review, design tokens and design-system demos",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "design-demo": "tsx packages/demo-generator/src/cli.ts",
    "spike:snapshot": "tsx packages/snapshot/spike/run.ts",
    "canvas-snapshot": "tsx packages/snapshot/src/cli.ts",
    "canvas-serve": "tsx packages/canvas-server/src/cli.ts",
    "ui-review": "tsx packages/canvas-server/src/ui-review.ts",
    "apply-review": "tsx packages/apply-review/src/cli.ts",
    "test:capture": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "single-file-cli": "^2.0.83",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
